# Chave da API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/)
# Se configurada, usa IA de visão do Gemini para reconhecer nomes com 100% de precisão
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini a ser utilizado (padrão: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Token do Bot do Telegram (opcional, para usar via Telegram)
TELEGRAM_BOT_TOKEN=seu_token_telegram_aqui

# Porta para o servidor web (padrão: 8000)
WEB_PORT=8000
