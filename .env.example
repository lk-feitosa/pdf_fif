# ==============================================================================
# CONFIGURAÇÕES DO PDF FIF
# O sistema funciona 100% OFFLINE por padrão usando OCR local (Tesseract).
# ==============================================================================

# Porta do servidor web (padrão: 8000)
PORT=8000
WEB_PORT=8000

# Token do Bot do Telegram (opcional, para processar PDFs via Telegram)
TELEGRAM_BOT_TOKEN=

# ------------------------------------------------------------------------------
# GOOGLE GEMINI (OPCIONAL)
# Preencha apenas se desejar usar IA para casos de documentos muito danificados.
# Obtenha gratuitamente em: https://aistudio.google.com/
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=sua_chave_gemini_aqui
# GEMINI_MODEL=gemini-2.0-flash

